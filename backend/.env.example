# Database: Use PostgreSQL in production/staging
# DATABASE_URL=postgresql+psycopg://junipay:junipay@localhost:5432/junipay_ledger
# Local SQLite fallback for quick MVP testing when PostgreSQL is unavailable:
DATABASE_URL=sqlite:///./junipay_ledger.db

# Configurable Ledger Assumptions (not hardcoded JuniPay business rules)
DEFAULT_CURRENCY=GHS
SETTLEMENT_DEFAULT_HOLD_MODE=PENDING
WEBHOOK_HMAC_SECRET=replace-with-junipay-shared-secret
ALLOW_UNSIGNED_DEV_EVENTS=true
AUTO_SEED_SAMPLE_DATA=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
